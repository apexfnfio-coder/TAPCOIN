    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bs58": "6.0.0",
    "next": "^14.2.35",
    "phaser": "3.80.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tweetnacl": "1.0.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  }
}
