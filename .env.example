# Local development: SQLite. Production: use a PostgreSQL URL and switch the
# provider in prisma/schema.prisma to "postgresql" before migration.
DATABASE_URL="file:./dev.db"

# Required in production. Generate at least 32 random bytes.
SESSION_SECRET="replace-with-a-long-random-secret"

# Comma-separated Solana public wallet addresses granted admin on verified login.
ADMIN_WALLETS="2Mz6kawWjgVVTKvPvs9xzhVV37qWP5aHM5EsbSYnndCE"

# Development-only seed switch. Never enable in production.
SEED_DEMO="false"

NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"
